# --- ログイン（Google アカウント） ---
# GCP コンソール「APIとサービス → 認証情報」で作成した OAuth クライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ログインを許可する Google アカウント（カンマ区切りで複数可）
ALLOWED_EMAILS=
# セッション暗号化用のランダム文字列（例: openssl rand -base64 32）
NEXTAUTH_SECRET=
# ローカル実行時のみ必要（Vercel では不要）
NEXTAUTH_URL=http://localhost:3000

# --- Firestore / Cloud Storage（Streamlit の Secrets の [gcp_service_account] と同じ値） ---
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
# private_key の値をそのまま（\n を含む1行のままで可）
GCP_PRIVATE_KEY=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- 英語アプリ: 音声保存用バケット ---
ENGLISH_AUDIO_BUCKET=

# --- からだ（Body Make）: 移行完了までは現行の Streamlit アプリの URL ---
BODY_APP_URL=

# --- ローカル開発用: 1 にすると Firestore / Gemini / ログインを使わずダミーデータで動く（本番では無効） ---
MOCK_BACKEND=
